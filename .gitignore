# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# uv keeps its cache here (cache-dir in uv.toml, relative to the project root),
# so `uv run` also works where the default ~/.cache/uv is read-only. None of it
# belongs in version control.
.local/

# Nix / direnv
.direnv/
result

# Bun (the backlog binary) falls back to ./node_modules/.cache when $HOME is
# read-only; BUN_INSTALL_CACHE_DIR in .envrc avoids that, and nothing here is
# installed by the repo itself.
node_modules/

# Editors
.vscode/
.idea/

# Agent harness state (keep the grader agent definitions and the commit command)
.claude/*
!.claude/agents/
.opencode/*
!.opencode/agents/
!.opencode/command/
