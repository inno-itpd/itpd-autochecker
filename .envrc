# Keep the home-dir writes that DSH's workspace-write sandbox cannot reach
# inside the checkout, the same way uv.toml keeps uv's cache in .local/uv-cache.
# XDG_CACHE_HOME must precede `use flake`: the shell it starts runs nix, which
# otherwise writes its fetcher locks to ~/.cache/nix and fails on the read-only
# mount. `direnv allow` itself is still a one-time step outside the sandbox,
# because direnv looks for its allow file under the caller's XDG_DATA_HOME.
export XDG_CACHE_HOME="$PWD/.local/cache"
export BUN_INSTALL_CACHE_DIR="$PWD/.local/bun-cache"

use flake

# Overrides any BACKLOG_CWD inherited from a shell started in another checkout,
# so `backlog` always operates on this repository.
export BACKLOG_CWD="$PWD"
