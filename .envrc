use flake

# `uv` needs a writable cache, and the default one (~/.cache/uv) can be mounted
# read-only: every `uv run` then fails with "Could not acquire lock ... Read-only
# file system". When that happens, point UV_CACHE_DIR at a cache inside the
# checkout. This block only acts when there is no usable cache directory yet, so
# the environment is refreshed at most once instead of on every reload.
uv_cache_default="${XDG_CACHE_HOME:-$HOME/.cache}/uv"
if [ -z "${UV_CACHE_DIR:-}" ] || [ ! -d "$UV_CACHE_DIR" ] || [ -z "$(ls -A "$UV_CACHE_DIR" 2>/dev/null)" ]; then
  if mkdir -p "$uv_cache_default" 2>/dev/null && touch "$uv_cache_default/.probe" 2>/dev/null; then
    rm -f "$uv_cache_default/.probe"
  else
    export UV_CACHE_DIR="$PWD/.local/uv-cache"
    mkdir -p "$UV_CACHE_DIR"
  fi
fi
